    "render:example": "remotion render src/index.ts Episode out/example.mp4 --props=manifests/example.json",
    "skills:install": "npx skills add remotion-dev/skills"
  },
  "dependencies": {
    "@remotion/cli": "4.0.509",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.509",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  }
}
