    {"id": "CAP010", "startSec": 0.35, "endSec": 2.6, "text": "ФИНЧ! ОТМЕНИ ЖЕЛАНИЕ!"},
    {"id": "CAP030A", "startSec": 5.2, "endSec": 8.1, "text": "Любое желание. Без посредников, магии и бумажной волокиты."},
    {"id": "CAP030B", "startSec": 8.2, "endSec": 9.8, "text": "Последнее звучит опаснее всего."},
