    {"id": "CAP050B", "startSec": 18.2, "endSec": 19.3, "text": "Точность."},
    {"id": "CAP060A", "startSec": 20.3, "endSec": 22.6, "text": "Видишь? Абсолютно безопасно."},
    {"id": "CAP060B", "startSec": 23.1, "endSec": 24.7, "text": "Клепп… а это что?"},
    {"id": "CAP070A", "startSec": 25.8, "endSec": 27.3, "text": "Всегда хотел такую."},
    {"id": "CAP070B", "startSec": 27.7, "endSec": 29.4, "text": "Это была фигура речи."},
