# CARTOON NICHE RADAR + CARTOON FACTORY — environment template
# Copy to .env and fill in values. Never commit real secrets.

# Required for Radar Phase 1 primary collection
YOUTUBE_API_KEY=

# Optional LLM classification / Factory text generation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
CLASSIFIER_PROVIDER=heuristic  # heuristic | openai

# Optional secondary sources (disabled by default in config/sources.yaml)
ENABLE_TIKTOK_PUBLIC=false
ENABLE_INSTALOADER=false
ENABLE_GOOGLE_TRENDS=true

# Radar storage
DATABASE_URL=sqlite:///data/cartoon_niche_radar.db

# Collection safety — granular quotas live in config/quota.yaml (PT reset).
# Prefer staged protocol: A=500, B=2000, C=10000+
YOUTUBE_MAX_RESULTS_PER_QUERY=50
MIN_CONFIDENCE_FOR_LABEL=0.55

# Cartoon Factory V1
# Core/fake smoke does not require any of these values.
FACTORY_DATABASE_URL=sqlite:///data/cartoon_factory.db
FACTORY_WEBHOOK_URL=

# Paid media provider — never required by tests/CI.
RUNWAYML_API_SECRET=

# S3-compatible production object storage (Cloudflare R2 or equivalent).
# Local development can use data/factory/assets instead.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
