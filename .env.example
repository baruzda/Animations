# CARTOON NICHE RADAR — environment template
# Copy to .env and fill in values. Never commit real secrets.

# Required for Phase 1 primary collection
YOUTUBE_API_KEY=

# Optional LLM classification (Phase 4). If empty, heuristic classifier only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
CLASSIFIER_PROVIDER=heuristic  # heuristic | openai

# Optional secondary sources (disabled by default in config/sources.yaml)
ENABLE_TIKTOK_PUBLIC=false
ENABLE_INSTALOADER=false
ENABLE_GOOGLE_TRENDS=true

# Storage
DATABASE_URL=sqlite:///data/cartoon_niche_radar.db

# Collection safety — granular quotas live in config/quota.yaml (PT reset).
# Prefer staged protocol: A=500, B=2000, C=10000+
YOUTUBE_MAX_RESULTS_PER_QUERY=50
MIN_CONFIDENCE_FOR_LABEL=0.55
